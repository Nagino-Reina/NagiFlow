# NagiFlow backend configuration (env layer — highest precedence after runtime).
# Copy to .env or export in the environment. All keys are prefixed NAGIFLOW_.
# Secrets belong here (never in workspace config or the repo). See docs/13 §4, docs/15 §3.

# Workspace folder (holds SQLite db, characters, media, logs, ...). Default: ./workspace
# NAGIFLOW_WORKSPACE_DIR=./workspace

# HTTP server
# NAGIFLOW_HOST=127.0.0.1
# NAGIFLOW_PORT=8000

# CORS origins for the SPA dev server (comma-separated)
# NAGIFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default LLM provider (docs/06 §12). "ollama" (local) or "echo" (offline stub).
# The model must be installed first: `ollama pull <model>` (else chat returns provider.error).
# NAGIFLOW_DEFAULT_LLM=ollama
# NAGIFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
# NAGIFLOW_OLLAMA_MODEL=llama3.2

# Emotion & affect appraisal engine (docs/10 §3.2):
#   hybrid        - LLM appraisal with a deterministic lexicon fallback (default)
#   deterministic - lexicon/heuristic only (offline, reproducible)
#   off           - no appraisal
# NAGIFLOW_AFFECT_APPRAISAL=hybrid

# Default TTS provider (docs/06 §12, docs/08 §4).
#   silent        - offline stub (default; no heavy deps)
#   voxcpm        - in-process generation (needs the [voxcpm] extra: torch + voxcpm)
#   voxcpm_server - remote VoxCPM/OpenAI-compatible server (uses VOXCPM_BASE_URL)
# NAGIFLOW_DEFAULT_TTS=silent
# Synthesize audio for each chat reply so it can be played back (docs/11 §4.6). Best-effort.
# NAGIFLOW_SYNTHESIZE_REPLIES=true
# NAGIFLOW_VOXCPM_MODEL=openbmb/VoxCPM2
# NAGIFLOW_VOXCPM_LOAD_DENOISER=false
# NAGIFLOW_VOXCPM_BASE_URL=http://127.0.0.1:9880
# NAGIFLOW_TTS_SAMPLE_RATE=48000

# Session lifetimes (seconds)
# NAGIFLOW_SESSION_TTL=2592000
# NAGIFLOW_GUEST_TTL=86400
