# NagiFlow backend configuration (env layer — highest precedence after runtime).
# Copy to .env or export in the environment. All keys are prefixed NAGIFLOW_.
# Secrets belong here (never in workspace config or the repo). See docs/13 §4, docs/15 §3.

# Workspace folder (holds SQLite db, characters, media, logs, ...). Default: ./workspace
# NAGIFLOW_WORKSPACE_DIR=./workspace

# HTTP server
# NAGIFLOW_HOST=127.0.0.1
# NAGIFLOW_PORT=8000

# CORS origins for the SPA dev server (comma-separated)
# NAGIFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default LLM provider (docs/06 §12). "ollama" (local) or "echo" (offline stub).
# NAGIFLOW_DEFAULT_LLM=ollama
# NAGIFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
# NAGIFLOW_OLLAMA_MODEL=llama3.2

# Session lifetimes (seconds)
# NAGIFLOW_SESSION_TTL=2592000
# NAGIFLOW_GUEST_TTL=86400
