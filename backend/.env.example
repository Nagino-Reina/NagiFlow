# =============================================================================
# NagiFlow Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application ---
APP_NAME=NagiFlow
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Workspace ---
# Directory where all dynamic files (models, audio, uploads) are stored at runtime.
WORKSPACE_DIR=./workspace

# --- Database ---
# Default: SQLite (file path relative to workspace).
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/nagiflow
DATABASE_URL=sqlite+aiosqlite:///workspace/nagiflow.db

# --- Security ---
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
DEFAULT_LLM_PROVIDER=ollama       # ollama | openai_compat
DEFAULT_LLM_MODEL=gpt-oss:20b

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible endpoint (used when DEFAULT_LLM_PROVIDER=openai_compat)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- TTS ---
DEFAULT_TTS_PROVIDER=voxcpm2      # voxcpm2 | voicevox | (extend via plugins)
VOICEVOX_BASE_URL=http://localhost:50021
DEFAULT_VOICEVOX_SPEAKER=1

# --- CORS ---
# Comma-separated list of allowed origins. Use * for development only.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Initial Admin Account (auto-created on first startup) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-password

# --- VoxCPM2 TTS (local inference, pip install 'nagiflow[voxcpm2]') ---
VOXCPM2_MODEL_ID=openbmb/VoxCPM2
VOXCPM2_DEVICE=auto           # auto | cpu | cuda | cuda:0
VOXCPM2_CFG_VALUE=2.0
VOXCPM2_INFERENCE_TIMESTEPS=10
VOXCPM2_LOAD_DENOISER=false

# --- Embedding ---
# Provider used for generating vector embeddings for memory/knowledge search.
# Options: ollama_embed | openai_embed | simple (hash-based fallback)
EMBEDDING_PROVIDER=ollama_embed
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
